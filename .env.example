# MoneyPrinterTurbo authentication (optional)
# Default: auth disabled for backward compatibility.
# Production: set MPT_AUTH_ENABLED=true and use HTTPS + strong secrets.

MPT_AUTH_ENABLED=false

# PostgreSQL connection string (required when auth is enabled).
# Do not commit real credentials.
DATABASE_URL=postgresql://username:password@localhost:5432/moneyprinter_auth

# Long random secret used for CSRF / establish-code HMAC (not the session cookie value).
MPT_SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Session lifetime in hours (default 24).
MPT_SESSION_EXPIRE_HOURS=24

# Set true behind HTTPS (Coolify / reverse proxy). Local HTTP can stay false.
MPT_COOKIE_SECURE=false

# Public API base URL for Streamlit → Set-Cookie bridge (no trailing slash).
# Behind same-origin reverse proxy you can leave this empty (uses relative /auth/establish).
# Example local API: http://127.0.0.1:8081
MPT_PUBLIC_API_URL=

# Public WebUI URL used as redirect target after establish (optional).
# Example: http://127.0.0.1:8501
MPT_PUBLIC_WEBUI_URL=

# ---------------------------------------------------------------------------
# Docker published ports (host bind + host port + container port)
# Used by docker-compose.yml / docker-compose.release.yml / docker-compose.gpu.yml
# ---------------------------------------------------------------------------
MPT_WEBUI_HOST=127.0.0.1
MPT_WEBUI_PORT=8501
MPT_WEBUI_CONTAINER_PORT=8501

MPT_API_HOST=127.0.0.1
MPT_API_PORT=8081
MPT_API_CONTAINER_PORT=8080
